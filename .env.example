APP_ENV=local
DATABASE_URL=postgresql://baby_user:baby_password@db:5432/baby_monitor
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MODEL_DIR=/app/models

# Push is opt-in; set on API, analysis and notification worker together.
PUSH_ENABLED=false
PUSH_TTL_SECONDS=3600
PUSH_MAX_ATTEMPTS=5
# Only used in the optional push compose overlay:
FIREBASE_CREDENTIALS_FILE=C:/deploy/secrets/babyeye-firebase-admin.json

# Shared by job creation, executor and stratified validation (experimental small data).
TRAINING_MIN_PER_CLASS=3
AUTO_TRAIN_STABLE_VISION_AS_NORMAL=false
TRAINING_TRIGGER_ENABLED=false

# Live signaling protocol v2: per-account rooms and bounded connection leases.
LIVE_PENDING_TIMEOUT_SECONDS=60
LIVE_IDLE_TIMEOUT_SECONDS=45
LIVE_AUTH_TIMEOUT_SECONDS=8
LIVE_MAX_SESSIONS_PER_USER=8
# Add operator-provided TURN entries here when STUN cannot traverse the network.
LIVE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"}]'
